{
  "name": "provenance-local",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "chain": "hardhat node --hostname 127.0.0.1",
    "deploy": "hardhat run scripts/deploy.cjs --network localhost",
    "test": "hardhat test test/registry.cjs && node --test test/metadata.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.cjs",
    "smoke": "node scripts/smoke.cjs",
    "test:browser": "node scripts/browser-test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "test:smoke": "node scripts/integration.cjs --smoke-only"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.1",
    "autoprefixer": "10.4.21",
    "chai": "4.5.0",
    "hardhat": "2.28.0",
    "playwright": "1.56.1",
    "postcss": "8.5.6",
    "solc": "0.8.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
